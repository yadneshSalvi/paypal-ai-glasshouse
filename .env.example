# Server-side values. Never prefix provider credentials with NEXT_PUBLIC_.
DATABASE_URL=postgresql://glasshouse:replace-me@127.0.0.1:55432/hack_glasshouse
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_PLANNER_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=max
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# AG's browser license is intentionally passed only to its official license manager.
AG_STUDIO_LICENSE_KEY=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_PROJECT_ISOLATED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Stable HTTPS app origin + /api/webhooks/paypal, registered on this isolated app.
PAYPAL_WEBHOOK_ID=
# Bind that registration to the seller and one existing owned fernwood tenant.
PAYPAL_MERCHANT_ID=
GLASSHOUSE_PAYPAL_TENANT_ID=
AUTH_SECRET=
JUDGE_SESSION_SECRET=
CRON_SECRET=
# Base64-encoded 32-byte key for authenticated private payment documents.
GLASSHOUSE_PAYMENT_KEY=
# Stable base64 32-byte agent key; when omitted, the existing payment key is used.
# Preserve the chosen key before the one-time private-history migration.
GLASSHOUSE_AGENT_KEY=
# Stable, private 32-byte base64 keys for access links and immutable reports.
# When omitted, each uses the existing payment key with a separate cipher domain.
# Do not rotate an admitted key without a separately verified migration.
GLASSHOUSE_WORKSPACE_KEY=
GLASSHOUSE_REPORT_KEY=
# Stable finding lifecycle key; defaults to the agent key, then the payment key.
# Preserve the chosen key. Old encrypted findings, commands and authority records are immutable.
GLASSHOUSE_FINDING_KEY=
GLASSHOUSE_TOOLKIT_READS_ENABLED=false
GLASSHOUSE_AGENT_WORKER_ENABLED=false
# Local QA can use a distinct cookie without touching another workspace session.
GLASSHOUSE_SESSION_COOKIE=glasshouse_session
