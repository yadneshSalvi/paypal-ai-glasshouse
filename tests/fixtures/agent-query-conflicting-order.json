{
  "query": {
    "kind": "apiQuery",
    "variant": "aggregation",
    "axes": [
      {
        "dimensions": [
          {
            "field": {
              "id": "finding_snapshot.kind"
            },
            "as": "kind"
          },
          {
            "field": {
